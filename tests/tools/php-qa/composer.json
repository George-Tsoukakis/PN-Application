{
	"name": "plandose/php-qa",
	"description": "Dev-only static analysis for the PlanDose plugin (PHPStan + PHP_CodeSniffer/WPCS). Not shipped.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"php": ">=8.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.2",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload-dev": {
		"psr-4": {
			"PlanDose\\PhpQa\\": "src/"
		}
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true,
		"allow-plugins": false
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=2G --no-progress",
		"phpcs": "phpcs",
		"qa": [
			"@phpstan",
			"@phpcs"
		]
	}
}
